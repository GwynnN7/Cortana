[Unit]
Description=Cortana Web Dashboard
After=network.target cortana-kernel.service
Requires=cortana-kernel.service
PartOf=cortana-kernel.service

[Service]
Type=simple
WorkingDirectory=%h/Cortana
ExecStart=%h/Cortana/CortanaWeb/out/CortanaWeb
ExecStartPre=/bin/rm -rf %h/Cortana/CortanaWeb/out
ExecStartPre=/usr/bin/dotnet publish %h/Cortana/CortanaWeb -o %h/Cortana/CortanaWeb/out --artifacts-path %h/Cortana/CortanaWeb/out/lib
EnvironmentFile=%h/.config/cortana/.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=CortanaWeb

