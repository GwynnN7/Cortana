# /etc/nginx/sites-available/default
# Front door for Cortana: dashboard on /, REST API on /api/.

# WebSocket upgrade passthrough; Blazor Server's circuit dies without it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    listen 8080;
    listen [::]:8080;

    # Video downloads stream through here.
    client_max_body_size 512M;

    # CortanaWeb - Blazor Server, needs HTTP/1.1 + upgrade for its WebSocket circuit.
    location / {
        proxy_pass http://127.0.0.1:5118/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # An idle circuit must outlive nginx's 60s default or the tab drops.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # CortanaKernel REST API. CORS is emitted by the API itself - adding it here too
    # produces duplicate headers, which browsers reject outright.
    location /api/ {
        proxy_pass http://127.0.0.1:5117/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
