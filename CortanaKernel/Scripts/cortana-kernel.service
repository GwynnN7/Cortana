[Unit]
Description=Cortana Kernel
After=network.target
Wants=cortana-web.service cortana-discord.service cortana-telegram.service

[Service]
Type=simple
WorkingDirectory=%h/Cortana
ExecStart=%h/Cortana/CortanaKernel/out/CortanaKernel
ExecStartPre=/bin/rm -rf %h/Cortana/CortanaKernel/out
ExecStartPre=/usr/bin/dotnet publish %h/Cortana/CortanaKernel -o %h/Cortana/CortanaKernel/out --artifacts-path %h/Cortana/CortanaKernel/out/lib
EnvironmentFile=%h/.config/cortana/.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=CortanaKernel

[Install]
WantedBy=default.target

