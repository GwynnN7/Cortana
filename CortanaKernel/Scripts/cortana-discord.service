[Unit]
Description=Cortana Discord Bot
After=network.target cortana-kernel.service
Requires=cortana-kernel.service
PartOf=cortana-kernel.service

[Service]
Type=simple
WorkingDirectory=%h/Cortana
ExecStart=%h/Cortana/CortanaDiscord/out/CortanaDiscord
ExecStartPre=/bin/rm -rf %h/Cortana/CortanaDiscord/out
ExecStartPre=/usr/bin/dotnet publish %h/Cortana/CortanaDiscord -o %h/Cortana/CortanaDiscord/out --artifacts-path %h/Cortana/CortanaDiscord/out/lib
EnvironmentFile=%h/.config/cortana/.env
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=CortanaDiscord

