@page "/"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Cortana</PageTitle>

<h1 class="visually-hidden">Dashboard</h1>

<Toast @bind-Message="_message"/>

<section class="section">
    <header class="section-head">
        <h2>Hi, I'm Cortana</h2>
        <div class="btn-row">
            @if (_chatOpen)
            {
                <button class="btn btn-ghost" @onclick="ClearChat">Clear</button>
            }
            <button class="btn btn-ghost" @onclick="() => _chatOpen = !_chatOpen">@(_chatOpen ? "Hide" : "Chat")</button>
        </div>
    </header>

    <div class="chips">
        @foreach (ESubFunctionType type in Enum.GetValues<ESubFunctionType>())
        {
            <span class="chip @(State.SubfunctionRunning(type) ? "chip-ok" : "chip-bad")">
                <span class="dot"></span>@type.ToString().Replace("Cortana", "")
            </span>
        }
    </div>

    <div class="chat-body @(_chatOpen ? "" : "collapsed")">
        <ChatPanel @ref="_chat" ShowHeader="false"/>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2><a class="section-link" href="/sensors">Sensors</a></h2>
        <span class="badge @(State.SensorsOnline ? "badge-ok" : "badge-bad")">
            @(State.SensorsOnline ? "Station online" : "Station offline")
        </span>
    </header>

    <div class="tiles tiles-6">
        <StatTile Icon="🌡" Label="Temperature" Value="@State.SensorValue(ESensor.Temperature)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💧" Label="Humidity" Value="@State.SensorValue(ESensor.Humidity)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💡" Label="Light" Value="@State.SensorValue(ESensor.Light)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🖲" Label="Motion" Value="@State.SensorValue(ESensor.Motion)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🧪" Label="CO₂" Value="@State.SensorValue(ESensor.CO2)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🦠" Label="TVOC" Value="@State.SensorValue(ESensor.Tvoc)" Muted="!State.SensorsOnline"/>
    </div>

    <div class="toggle-row">
        <div>
            <strong>Automatic mode</strong>
            <small>@AutomationHint</small>
        </div>
        <button class="switch @(State.AutomationRunning ? "switch-on" : "")"
                role="switch" aria-checked="@(State.AutomationRunning ? "true" : "false")"
                aria-label="Automatic mode" disabled="@_busy" @onclick="ToggleAutomatic"><span class="knob"></span></button>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2><a class="section-link" href="/devices">Quick Toggles</a></h2>
    </header>

    <div class="quick-grid">
        <button class="quick" disabled="@_busy" @onclick="() => Run(State.Sleep)">
            <span class="quick-emoji" aria-hidden="true">🛌</span> Sleep
            <small>Mode</small>
        </button>
        @foreach ((EDevice device, string emoji, bool compact) in QuickDevices)
        {
            <button class="quick @(State.IsDeviceOn(device) ? "quick-active" : "") @(compact ? "" : "quick-wide")"
                    disabled="@_busy" @onclick="() => Run(() => State.SwitchDevice(device, ESwitchAction.Toggle))">
                <span class="quick-emoji" aria-hidden="true">@emoji</span> @device
                <small>@State.DeviceStatus(device)</small>
            </button>
        }
    </div>
</section>

<ComputerCard Metrics="State.Computer"/>

<ComputerCard Metrics="State.RaspberryMetrics"/>

<section class="section section-more">
    <header class="section-head">
        <h2>More</h2>
    </header>

    <div class="quick-grid">
        <a class="quick" href="/raspberry"><span aria-hidden="true">🧠</span> Core</a>
        <a class="quick" href="/utility"><span aria-hidden="true">🧰</span> Utility</a>
        <a class="quick" href="/logs"><span aria-hidden="true">📜</span> Logs</a>
        <a class="quick" href="/settings"><span aria-hidden="true">⚙️</span> Settings</a>
    </div>
</section>

@code {
    private static readonly (EDevice Device, string Emoji, bool Compact)[] QuickDevices =
    [
        (EDevice.Lamp, "💡", true),
        (EDevice.Generic, "🔌", true),
        (EDevice.Computer, "🖥️", true),
        (EDevice.Power, "⚡", false)
    ];

    private ChatPanel? _chat;
    private bool _chatOpen;

    private async Task ClearChat()
    {
        if (_chat != null) await _chat.ClearAsync();
    }

    private IDisposable? _subscription;
    private string? _message;
    private bool _busy;

    protected override void OnInitialized() =>
        _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private string AutomationHint => State.AutomationState switch
    {
        nameof(EAutomationState.Night) => "Night mode until morning",
        nameof(EAutomationState.Manual) when State.ManualMinutesLeft > 0 =>
            $"Manual hold, back to automatic in {State.ManualMinutesLeft} min",
        nameof(EAutomationState.Manual) => "Manual control only",
        _ => "Motion controls the lamp"
    };

    private Task ToggleAutomatic()
    {
        EStatus target = State.AutomationRunning ? EStatus.Off : EStatus.On;
        return Run(() => State.SetSetting(ESettings.AutomaticMode, (int)target));
    }

    private async Task Run(Func<Task<string>> action)
    {
        _busy = true;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
