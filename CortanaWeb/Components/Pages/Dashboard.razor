@page "/"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Cortana</PageTitle>

<h1 class="visually-hidden">Dashboard</h1>

<Toast @bind-Message="_message"/>

<section class="section">
    <header class="section-head">
        <h2>Hi, I'm Cortana</h2>
        <div class="btn-row">
            @if (_chatOpen)
            {
                <button class="btn btn-ghost" @onclick="ClearChat">Clear</button>
            }
            <button class="btn btn-ghost" @onclick="() => _chatOpen = !_chatOpen">@(_chatOpen ? "Hide" : "Chat")</button>
        </div>
    </header>

    <div class="chips">
        @foreach (ServiceId service in Enum.GetValues<ServiceId>())
        {
            <span class="chip @(State.ServiceRunning(service) ? "chip-ok" : "chip-bad")">
                <span class="dot"></span>@service
            </span>
        }
    </div>

    <div class="chat-body @(_chatOpen ? "" : "collapsed")">
        <ChatPanel @ref="_chat" ShowHeader="false"/>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2><a class="section-link" href="/sensors">Sensors</a></h2>
        <span class="badge @(State.SensorsOnline ? "badge-ok" : "badge-bad")">
            @(State.SensorsOnline ? "Station Online" : "Station Offline")
        </span>
    </header>

    <div class="tiles tiles-6">
        <StatTile Icon="🌡" Label="Temperature" Value="@State.SensorValue(SensorId.Temperature)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💧" Label="Humidity" Value="@State.SensorValue(SensorId.Humidity)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💡" Label="Light" Value="@State.SensorValue(SensorId.Light)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="@State.MotionIcon" Label="Motion" Value="@State.SensorValue(SensorId.Motion)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🧪" Label="CO₂" Value="@State.SensorValue(SensorId.Co2)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🦠" Label="TVOC" Value="@State.SensorValue(SensorId.Tvoc)" Muted="!State.SensorsOnline"/>
    </div>

    <div class="toggle-row">
        <div>
            <strong>Automation</strong>
            <small>@AutomationHint</small>
        </div>
        <div class="toggle-actions">
            @if (State.Automation.HoldingUntil is not null)
            {
                <button class="btn btn-small" disabled="@_busy" @onclick="() => Run(State.ReleaseHolds)">Resume</button>
            }
            <button class="switch @SwitchClass"
                    role="switch" aria-checked="@(State.Automation.Enabled ? "true" : "false")"
                    aria-label="Automation" disabled="@_busy" @onclick="() => Run(() => State.SetAutomation(SwitchAction.Toggle))"><span class="knob"></span></button>
        </div>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2><a class="section-link" href="/devices">Quick Toggles</a></h2>
    </header>

    <div class="quick-grid">
        <button class="quick @(State.Automation.SleepMode ? "quick-active" : "")" disabled="@_busy"
                @onclick="() => Run(() => State.SetSleepMode(SwitchAction.Toggle))">
            <span class="quick-emoji" aria-hidden="true">🛌</span> Sleep
            <small>@(State.Automation.SleepMode ? "Active" : "Off")</small>
        </button>
        @foreach ((DeviceId device, string emoji, bool compact) in QuickDevices)
        {
            <button class="quick @(State.IsDeviceOn(device) ? "quick-active" : "") @(compact ? "" : "quick-wide")"
                    disabled="@_busy" @onclick="() => Run(() => State.SwitchDevice(device, SwitchAction.Toggle))">
                <span class="quick-emoji" aria-hidden="true">@emoji</span> @device
                <small>@State.DeviceStatus(device)</small>
            </button>
        }
    </div>
</section>

<ComputerCard Metrics="State.Computer" Activity="State.Activity"/>

<ComputerCard Metrics="State.RaspberryMetrics"/>

<section class="section section-more">
    <header class="section-head">
        <h2>More</h2>
    </header>

    <div class="quick-grid">
        <a class="quick" href="/core"><span aria-hidden="true">🧠</span> Core</a>
        <a class="quick" href="/utility"><span aria-hidden="true">🧰</span> Utility</a>
        <a class="quick" href="/logs"><span aria-hidden="true">📜</span> Logs</a>
        <a class="quick" href="/settings"><span aria-hidden="true">⚙️</span> Settings</a>
    </div>
</section>

@code {

    private static readonly (DeviceId Device, string Emoji, bool Compact)[] QuickDevices =
    [
        (DeviceId.Lamp, "💡", true),
        (DeviceId.Generic, "🔌", true),
        (DeviceId.Computer, "🖥️", true),
        (DeviceId.Power, "⚡", false)
    ];

    private ChatPanel? _chat;
    private bool _chatOpen;
    private IDisposable? _subscription;
    private string? _message;
    private bool _busy;

    protected override void OnInitialized() => _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private async Task ClearChat()
    {
        if (_chat != null) await _chat.ClearAsync();
    }

    private string SwitchClass => State.Automation.Status switch
    {
        AutomationStatus.Holding => "switch-hold",
        AutomationStatus.Active => "switch-on",
        _ => ""
    };

    private string AutomationHint => State.Automation switch
    {
        { Status: AutomationStatus.Off } => "Manual control only",
        { Status: AutomationStatus.Holding, HoldingUntil: { } until } => $"Holding until {until:HH:mm}",
        { Status: AutomationStatus.Holding, DesktopHold: true } => "Holding, fullscreen app detected",
        { SleepMode: true } => "Sleep rules are active",
        _ => "Motion controls the lamp"
    };

    private async Task Run(Func<Task<string>> action)
    {
        _busy = true;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
