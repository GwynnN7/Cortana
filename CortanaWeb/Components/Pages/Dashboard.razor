@page "/"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Cortana</PageTitle>

<h1 class="visually-hidden">Dashboard</h1>

<Toast @bind-Message="_message"/>

<section class="section">
    <header class="section-head">
        <h2>Room</h2>
        <span class="badge @(State.SensorsOnline ? "badge-ok" : "badge-bad")">
            @(State.SensorsOnline ? "Station online" : "Station offline")
        </span>
    </header>

    <div class="tiles tiles-6">
        <StatTile Icon="🌡" Label="Temperature" Value="@State.SensorValue(ESensor.Temperature)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💧" Label="Humidity" Value="@State.SensorValue(ESensor.Humidity)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="💡" Label="Light" Value="@State.SensorValue(ESensor.Light)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🖲" Label="Motion" Value="@State.SensorValue(ESensor.Motion)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🧪" Label="CO₂" Value="@State.SensorValue(ESensor.CO2)" Muted="!State.SensorsOnline"/>
        <StatTile Icon="🦠" Label="TVOC" Value="@State.SensorValue(ESensor.Tvoc)" Muted="!State.SensorsOnline"/>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2>Devices</h2>
        <a class="link" href="/devices">All devices</a>
    </header>

    <div class="quick-grid">
        <button class="quick @(State.IsDeviceOn(EDevice.Lamp) ? "quick-active" : "")" disabled="@_busy"
                @onclick="() => Run(() => State.SwitchDevice(EDevice.Lamp, ESwitchAction.Toggle))">
            <Icon Name="lamp" Size="26"/> Lamp
            <small>@State.DeviceStatus(EDevice.Lamp)</small>
        </button>
        <button class="quick @(State.IsDeviceOn(EDevice.Generic) ? "quick-active" : "")" disabled="@_busy"
                @onclick="() => Run(() => State.SwitchDevice(EDevice.Generic, ESwitchAction.Toggle))">
            <Icon Name="plug" Size="26"/> Generic
            <small>@State.DeviceStatus(EDevice.Generic)</small>
        </button>
        <button class="quick @(State.IsDeviceOn(EDevice.Power) ? "quick-active" : "")" disabled="@_busy"
                @onclick="() => Run(() => State.SwitchDevice(EDevice.Power, ESwitchAction.Toggle))">
            <Icon Name="power" Size="26"/> Power
            <small>@State.DeviceStatus(EDevice.Power)</small>
        </button>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2>Automation</h2>
        <span class="badge @(State.SettingEnabled(ESettings.AutomaticMode) ? "badge-ok" : "badge-bad")">
            @(State.SettingEnabled(ESettings.AutomaticMode) ? "Automatic" : "Manual")
        </span>
    </header>

    <div class="toggle-row">
        <div>
            <strong>Automatic mode</strong>
            <small>@(State.SettingEnabled(ESettings.AutomaticMode) ? "Motion controls the lamp" : "Manual control only")</small>
        </div>
        <button class="switch @(State.SettingEnabled(ESettings.AutomaticMode) ? "switch-on" : "")"
                role="switch" aria-checked="@(State.SettingEnabled(ESettings.AutomaticMode) ? "true" : "false")"
                aria-label="Automatic mode" disabled="@_busy" @onclick="ToggleAutomatic"><span class="knob"></span></button>
    </div>

    <div class="toggle-row">
        <div>
            <strong>Sleep mode</strong>
            <small>Lamp off and manual until morning</small>
        </div>
        <button class="btn" disabled="@_busy" @onclick="() => Run(State.Sleep)">
            <Icon Name="bed" Size="18"/> Sleep now
        </button>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2>System</h2>
    </header>

    <div class="tiles tiles-4">
        <StatTile Icon="🍓" Label="CPU temperature" Value="@State.RaspberryInfo(ERaspberryInfo.Temperature)"/>
        <StatTile Icon="📍" Label="Location" Value="@State.RaspberryInfo(ERaspberryInfo.Location)"/>
        <StatTile Icon="📬" Label="Public IP" Value="@State.RaspberryInfo(ERaspberryInfo.Ip)"/>
        <StatTile Icon="🌐" Label="Gateway" Value="@State.RaspberryInfo(ERaspberryInfo.Gateway)"/>
    </div>

    <div class="chips">
        @foreach (ESubFunctionType type in Enum.GetValues<ESubFunctionType>())
        {
            <span class="chip @(State.SubfunctionRunning(type) ? "chip-ok" : "chip-bad")">
                <span class="dot"></span>@type.ToString().Replace("Cortana", "")
            </span>
        }
    </div>
</section>

<section class="section section-more">
    <header class="section-head">
        <h2>More</h2>
    </header>

    <div class="quick-grid">
        <a class="quick" href="/raspberry"><span aria-hidden="true">🍓</span> Raspberry</a>
        <a class="quick" href="/schedules"><span aria-hidden="true">⏰</span> Schedules</a>
        <a class="quick" href="/subfunctions"><span aria-hidden="true">🧠</span> Subfunctions</a>
        <a class="quick" href="/utility"><span aria-hidden="true">🧰</span> Utility</a>
    </div>
</section>

@code {
    private IDisposable? _subscription;
    private string? _message;
    private bool _busy;

    protected override void OnInitialized() =>
        _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private Task ToggleAutomatic()
    {
        EStatus target = State.SettingEnabled(ESettings.AutomaticMode) ? EStatus.Off : EStatus.On;
        return Run(() => State.SetSetting(ESettings.AutomaticMode, (int)target));
    }

    private async Task Run(Func<Task<string>> action)
    {
        _busy = true;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
