@page "/settings"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@inherits ActingPage
@implements IDisposable

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>
<Toast @bind-Message="Message"/>

<TabStrip Tabs="Tabs" Current="@_tab" CurrentChanged="tab => _tab = tab">

@if (_tab == "automation")
{
    <section class="section">
        <header class="section-head">
            <h2>Automation</h2>
        </header>

        <div class="toggle-row">
            <div>
                <strong>Automation</strong>
                <small>@AutomationHint</small>
            </div>
            <div class="toggle-actions">
                @if (State.Automation.Status == AutomationStatus.Holding)
                {
                    <button class="btn btn-small" disabled="@Busy" @onclick="() => Run(State.ReleaseHolds)">Resume</button>
                }
                <button class="switch @SwitchClass"
                        role="switch" aria-checked="@(State.Automation.Enabled ? "true" : "false")" aria-label="Automation"
                        disabled="@Busy" @onclick="ToggleAutomation">
                    <span class="knob"></span>
                </button>
            </div>
        </div>

        <div class="settings-grid">
            <NumberSetting Setting="SettingKey.MorningHour" Label="Morning Hour" Hint="0-23, when the night ends" Icon="🌅" Max="23" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.NightHour" Label="Night Hour" Hint="0-23, when the night begins" Icon="🌇" Max="23" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.ComputerShutdownGraceSeconds" Label="Shutdown Hold" Hint="seconds after pc is off before cutting power" Icon="⚡" Max="600" OnResult="Report"/>
        </div>
    </section>

    <section class="section">
        <header class="section-head">
            <h2>Presence</h2>
        </header>

        <div class="settings-grid">
            <NumberSetting Setting="SettingKey.MotionTimeoutSeconds" Label="Presence Lingers" Hint="seconds it stays true after the last sensor goes quiet" Icon="⏳" Max="3600" Min="1" OnResult="Report"/>
        </div>

        <p class="section-hint">Which sensors count is set on <a href="/hardware">Hardware</a></p>
    </section>

    <section class="section">
        <header class="section-head">
            <h2>Sleep and overrides</h2>
        </header>

        <div class="settings-grid">
            <NumberSetting Setting="SettingKey.ManualOverrideMinutes" Label="Manual Override" Hint="minutes the day hold pauses automation" Icon="✋" Min="1" Max="720" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.SleepManualOverrideMinutes" Label="Sleep Override" Hint="minutes the night hold pauses automation" Icon="🌙" Min="1" Max="720" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.SleepEntryDelayMinutes" Label="Sleep Delay" Hint="minutes between the night starting and sleep mode" Icon="⏱" Max="720" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.SleepHoldMinutes" Label="Sleep Hold" Hint="minutes automatic sleep stays suppressed after manual override" Icon="🚫" Min="1" Max="720" OnResult="Report"/>
            <NumberSetting Setting="SettingKey.DaySleepMinutes" Label="Daytime Sleep" Hint="minutes a daytime sleep mode lasts" Icon="🛌" Min="1" Max="1440" OnResult="Report"/>
        </div>
    </section>
}
else if (_tab == "ai")
{
    <AiSettingsPanel OnResult="Report"/>

    <section class="section">
        <header class="section-head">
            <h2>Memory</h2>
        </header>

        <AiNumberSetting Setting="AiSettingKey.MemoryDepth" Label="Memories in prompt" Min="0" Max="60" Step="1" OnResult="Report"/>
        <AiNumberSetting Setting="AiSettingKey.MemoryStateHours" Label="Short memory lasts (h)" Min="1" Max="168" Step="1" OnResult="Report"/>
    </section>

    <section class="section">
        <header class="section-head">
            <h2>Wrap-up</h2>
        </header>

        <AiNumberSetting Setting="AiSettingKey.WrapupHour" Label="Written at (h)" Min="0" Max="23" Step="1" OnResult="Report"/>
        <AiNumberSetting Setting="AiSettingKey.WrapupChance" Label="Chance she says it" Min="0" Max="1" Step="0.05" OnResult="Report"/>
    </section>
}
else if (_tab == "history")
{
    <section class="section">
        <header class="section-head">
            <h2>History</h2>
        </header>

        <AiNumberSetting Setting="AiSettingKey.HistorySampleMinutes" Label="Sample every (min)" Min="1" Max="60" Step="1" OnResult="Report"/>
        <AiNumberSetting Setting="AiSettingKey.HistoryRetentionDays" Label="Keep for (days)" Min="1" Max="3650" Step="1" OnResult="Report"/>
    </section>
}
else if (_tab == "notifications")
{
    <section class="section">
        <header class="section-head">
            <h2>Where to send notifications</h2>
        </header>

        @foreach ((SettingKey setting, string title, string hint) in Destinations)
        {
            <div class="toggle-row">
                <div>
                    <strong>@title</strong>
                    <small>@hint</small>
                </div>
                <button class="switch @(State.SettingEnabled(setting) ? "switch-on" : "")" role="switch"
                        aria-checked="@Aria(setting)" aria-label="@title"
                        disabled="@Busy" @onclick="() => Toggle(setting)"><span class="knob"></span></button>
            </div>
        }
    </section>

    <section class="section">
        <header class="section-head">
            <h2>Hold</h2>
        </header>

        <AiNumberSetting Setting="AiSettingKey.PushEventSeconds" Label="Event stays up (s)" Min="1" Max="120" Step="1" OnResult="Report"/>

        <p class="section-hint">How long the persistent notification shows an event before falling back to the status line</p>
    </section>
}

</TabStrip>

@code {
    private static readonly (string Key, string Label)[] Tabs =
        [("automation", "Automation"), ("ai", "AI"), ("history", "History"), ("notifications", "Notifications")];

    private static readonly (SettingKey Setting, string Title, string Hint)[] Destinations =
    [
        (SettingKey.NotifyWeb, "Browser notification", "The persistent status notification"),
        (SettingKey.NotifyTelegram, "Telegram", "The log topic in the home group"),
        (SettingKey.NotifyDiscord, "Discord", "The log channel")
    ];

    private string SwitchClass => State.Automation.Status switch
    {
        AutomationStatus.Holding => "switch-hold",
        AutomationStatus.Active => "switch-on",
        _ => ""
    };

    private string AutomationHint => State.Automation switch
    {
        { Status: AutomationStatus.Off } => "Manual control only",
        { Status: AutomationStatus.Holding, HoldingUntil: { } until } => $"Holding until {until:HH:mm}",
        { Status: AutomationStatus.Idle } => "Nothing is bound yet",
        { SleepMode: true } => "Sleep rules are active",
        _ => "Binds are deciding"
    };

    private string _tab = "automation";
    private IDisposable? _subscription;

    protected override void OnInitialized() => _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private void Report(string result) => Message = result;

    private string Aria(SettingKey setting) => State.SettingEnabled(setting) ? "true" : "false";

    private Task ToggleAutomation() => Run(() => State.SetAutomation(SwitchAction.Toggle));

    private Task Toggle(SettingKey setting) => Run(() => State.SetSetting(setting, "Toggle"));

}
