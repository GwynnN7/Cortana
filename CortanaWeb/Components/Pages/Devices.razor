@page "/devices"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>
<Toast @bind-Message="_message"/>

<TabStrip Tabs="Tabs" Current="@_tab" CurrentChanged="tab => _tab = tab">
    <section class="section">
        <div class="card-grid">
            @foreach (DeviceView device in Shown)
            {
                <DeviceCard Device="@device.Device" Icon="@device.Icon" OnResult="Report"/>
            }
        </div>
    </section>

    @if (Machine)
    {
        <ComputerPanel/>
    }
</TabStrip>

@code {
    private IDisposable? _subscription;
    private string _tab = SourceIds.Raspberry;
    private string? _message;

    protected override void OnInitialized()
    {
        _subscription = State.Subscribe(() => InvokeAsync(OnSnapshot));
        EnsureTab();
    }

    public void Dispose() => _subscription?.Dispose();

    /// The snapshot arrives asynchronously, often after this runs once with nothing loaded yet.
    /// Only correct the tab once sources are actually known, so a real default is never wiped to ""
    private void EnsureTab()
    {
        if (Sources.Any() && !Sources.Contains(_tab)) _tab = Sources.First();
    }

    private void OnSnapshot()
    {
        EnsureTab();
        StateHasChanged();
    }

    private IEnumerable<string> Sources =>
        (State.Snapshot?.Devices ?? []).Select(view => view.Source).Distinct().Order();

    private IReadOnlyList<(string Key, string Label)> Tabs => [.. Sources.Select(source => (source, source))];

    private IReadOnlyList<DeviceView> Shown =>
        [.. (State.Snapshot?.Devices ?? []).Where(view => _tab.Length == 0 || view.Source == _tab)];

    /// A computer source is the one that can be told to do things as well as switched, so the tab
    /// showing it gets the panel the web restructure dropped
    private bool Machine => (State.Snapshot?.Sources ?? [])
        .Any(source => source.Id == _tab && source.Kind == SourceKind.Computer);

    private void Report(string result) => _message = result;
}
