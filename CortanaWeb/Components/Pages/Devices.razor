@page "/devices"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>
<Toast @bind-Message="_message"/>

<section class="section">
    <div class="card-grid">
        <DeviceCard Device="EDevice.Lamp" Icon="💡" OnResult="Report"/>
        <DeviceCard Device="EDevice.Generic" Icon="🔌" OnResult="Report"/>
        <DeviceCard Device="EDevice.Computer" Icon="💻" OnResult="Report"/>
        <DeviceCard Device="EDevice.Power" Icon="⚡" OnResult="Report"/>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2>Room</h2>
        <p class="section-hint">Switches the entire room and and off</p>
    </header>

    <div class="room">
        <div class="btn-row">
            <button class="btn btn-on" disabled="@_busy" @onclick="() => Run(() => State.SwitchRoom(ESwitchAction.On))">
                <span class="btn-emoji" aria-hidden="true">🏠</span> Room on
            </button>
            <button class="btn btn-off" disabled="@_busy" @onclick="() => Run(() => State.SwitchRoom(ESwitchAction.Off))">
                <span class="btn-emoji" aria-hidden="true">🌙</span> Room off
            </button>
        </div>
    </div>
</section>

<section class="section">
    <header class="section-head">
        <h2>Computer</h2>
        <p class="section-hint">Execute a command to the connected desktop</p>
        <span class="badge @(State.IsDeviceOn(EDevice.Computer) ? "badge-ok" : "badge-bad")">
            @(State.IsDeviceOn(EDevice.Computer) ? "Connected" : "Not connected")
        </span>
    </header>

    <div class="btn-row wrap">
        <button class="btn btn-off" disabled="@ComputerBusy" @onclick="() => RunPc(EComputerCommand.Shutdown)">Shutdown</button>
        <button class="btn" disabled="@ComputerBusy" @onclick="() => RunPc(EComputerCommand.Reboot)">Reboot</button>
        <button class="btn" disabled="@ComputerBusy" @onclick="() => RunPc(EComputerCommand.Suspend)">Suspend</button>
        <button class="btn" disabled="@ComputerBusy" @onclick="() => RunPc(EComputerCommand.System)">Switch OS</button>
    </div>

    <div class="stack">
        <div class="field-row">
            <input type="text" placeholder="Notification text" @bind="_notification" @bind:event="oninput"
                   disabled="@ComputerBusy" @onkeydown="@(e => OnEnter(e, SendNotification))"/>
            <button class="btn" disabled="@(ComputerBusy || string.IsNullOrWhiteSpace(_notification))" @onclick="SendNotification">Notify</button>
        </div>

        <div class="field-row">
            <input type="text" placeholder="Application to launch" @bind="_launch" @bind:event="oninput"
                   disabled="@ComputerBusy" @onkeydown="@(e => OnEnter(e, LaunchApp))"/>
            <button class="btn" disabled="@(ComputerBusy || string.IsNullOrWhiteSpace(_launch))" @onclick="LaunchApp">Launch</button>
        </div>

        <div class="field-row">
            <input type="text" placeholder="Shell command" @bind="_command" @bind:event="oninput"
                   disabled="@ComputerBusy" @onkeydown="@(e => OnEnter(e, SendCommand))"/>
            <button class="btn" disabled="@(ComputerBusy || string.IsNullOrWhiteSpace(_command))" @onclick="SendCommand">Run</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_commandOutput))
    {
        <pre class="console">@_commandOutput</pre>
    }
</section>


@code {
    private IDisposable? _subscription;
    private string? _message;
    private string _notification = "";
    private string _command = "";
    private string _launch = "";
    private string? _commandOutput;
    private bool _busy;

    private bool ComputerBusy => _busy || !State.IsDeviceOn(EDevice.Computer);

    protected override void OnInitialized() =>
        _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private void Report(string result) => _message = result;

    private static Task OnEnter(KeyboardEventArgs args, Func<Task> action) =>
        args.Key == "Enter" ? action() : Task.CompletedTask;

    private async Task RunPc(EComputerCommand command, string args = "")
    {
        _busy = true;
        try
        {
            _commandOutput = await State.ComputerCommand(command, args);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LaunchApp()
    {
        await RunPc(EComputerCommand.Launch, _launch);
        _launch = "";
    }

    private async Task SendNotification()
    {
        await RunPc(EComputerCommand.Notify, _notification);
        _notification = "";
    }

    private async Task SendCommand()
    {
        string command = _command;
        await RunPc(EComputerCommand.Command, command);
        _command = "";
    }

    private async Task Run(Func<Task<string>> action)
    {
        _busy = true;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
