@page "/sensors"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@implements IDisposable

<PageTitle>Sensors</PageTitle>

<h1>Sensors</h1>

<div class="subnav">
    @foreach ((string key, string label) in Tabs)
    {
        <button class="subnav-tab @(_tab == key ? "subnav-active" : "")" @onclick="() => _tab = key">@label</button>
    }
</div>

@if (_tab == "station")
{
    <section class="section">
        <header class="section-head">
            <h2>Station</h2>
            <span class="badge @(State.SensorsOnline ? "badge-ok" : "badge-bad")">
                @(State.SensorsOnline ? "Online" : "Offline")
            </span>
        </header>

        <div class="tiles tiles-6">
            <StatTile Icon="🌡" Label="Temperature" Value="@State.SensorValue(SensorId.Temperature)" Muted="!State.SensorsOnline"/>
            <StatTile Icon="💧" Label="Humidity" Value="@State.SensorValue(SensorId.Humidity)" Muted="!State.SensorsOnline"/>
            <StatTile Icon="💡" Label="Light" Value="@State.SensorValue(SensorId.Light)" Muted="!State.SensorsOnline"/>
            <StatTile Icon="🖲" Label="Motion" Value="@State.SensorValue(SensorId.Motion)" Muted="!State.SensorsOnline"/>
            <StatTile Icon="🧪" Label="CO₂" Value="@State.SensorValue(SensorId.Co2)" Muted="!State.SensorsOnline"/>
            <StatTile Icon="🦠" Label="TVOC" Value="@State.SensorValue(SensorId.Tvoc)" Muted="!State.SensorsOnline"/>
        </div>
    </section>

    <HistoryPanel Title="History" Metrics="@(new[] { "temperature", "humidity", "light", "co2", "tvoc", "motion", "lamp", "computer" })"/>
}
else if (_tab == "computer")
{
    <ComputerCard Metrics="State.Computer"/>
    <HistoryPanel Title="History" Metrics="@(new[] { "pc_cpu", "pc_temp", "pc_gpu", "pc_gpu_temp", "pc_ram" })"/>
}
else
{
    <ComputerCard Metrics="State.RaspberryMetrics"/>
    <HistoryPanel Title="History" Metrics="@(new[] { "pi_cpu", "pi_temp", "pi_ram" })"/>
}

@code {
    private static readonly (string Key, string Label)[] Tabs =
        [("station", "Station"), ("computer", "Computer"), ("raspberry", "Raspberry")];

    private string _tab = "station";
    private IDisposable? _subscription;

    protected override void OnInitialized() => _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();
}
