@page "/utility"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer

<PageTitle>Utility</PageTitle>

<h1>Utility</h1>

<SchedulePanel/>

<section class="section">
    <header class="section-head">
        <h2>QR code</h2>
    </header>

    <div class="field-row">
        <input type="text" placeholder="Text or URL to encode" @bind="_qrContent" @bind:event="oninput"/>
        <button class="btn" disabled="@string.IsNullOrWhiteSpace(_qrContent)" @onclick="RenderQr">Generate</button>
    </div>

    <div class="options">
        <label><input type="checkbox" @bind="_qrBorder"/> Quiet zone</label>
        <label><input type="checkbox" @bind="_qrClassic"/> Black &amp; white</label>
    </div>

    @if (_qrUrl != null)
    {
        <div class="qr-result">
            <img src="@_qrUrl" alt="Generated QR code"/>
            <a class="btn btn-ghost" href="@_qrUrl" download="qrcode.png">Download</a>
        </div>
    }
</section>

<section class="section">
    <header class="section-head">
        <h2>YouTube download</h2>
        <p class="section-hint">Large videos may take a while</p>
    </header>

    <div class="field-row">
        <input type="text" placeholder="YouTube URL or search terms" @bind="_query" @bind:event="oninput"/>
    </div>

    <div class="field-row">
        <select @bind="_quality">
            @foreach (VideoQuality quality in Enum.GetValues<VideoQuality>())
            {
                <option value="@quality">@Readable(quality)</option>
            }
        </select>
        <a class="btn @Disabled" href="@AudioUrl" target="_blank" rel="noopener">Audio</a>
        <a class="btn @Disabled" href="@VideoUrl" target="_blank" rel="noopener">Video</a>
    </div>
</section>

@code {
    private string _qrContent = "";
    private bool _qrBorder = true;
    private bool _qrClassic;
    private string? _qrUrl;

    private string _query = "";
    private VideoQuality _quality = VideoQuality.Balanced;

    private string Disabled => string.IsNullOrWhiteSpace(_query) ? "btn-disabled" : "";

    private string AudioUrl => $"/media/audio?url={Uri.EscapeDataString(_query)}";
    private string VideoUrl => $"/media/video?url={Uri.EscapeDataString(_query)}&quality={_quality}";

    private void RenderQr() =>
        _qrUrl = $"/media/qr?content={Uri.EscapeDataString(_qrContent)}&border={_qrBorder.ToString().ToLower()}&classic={_qrClassic.ToString().ToLower()}";

    private static string Readable(VideoQuality quality) => quality switch
    {
        VideoQuality.BestVideo => "Prioritise video quality",
        VideoQuality.BestAudio => "Prioritise audio quality",
        _ => "Balanced"
    };
}
