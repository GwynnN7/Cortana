@page "/quick/{Action}"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@inject NavigationManager Navigation

<PageTitle>@Title</PageTitle>

<div class="quick-run">
    <span class="quick-run-icon" aria-hidden="true">@Icon</span>
    <h1>@Title</h1>
    <p class="quick-run-result">@(_result ?? "Working...")</p>
    <a class="btn" href="/">Back to dashboard</a>
</div>

@code {
    [Parameter] public string Action { get; set; } = "";

    private string? _result;

    private static readonly Dictionary<string, (string Title, string Icon)> Known = new(StringComparer.OrdinalIgnoreCase)
    {
        { "sleep", ("Sleep mode", "🛌") },
        { "lamp", ("Toggle lamp", "💡") },
        { "generic", ("Toggle generic", "🔌") },
        { "computer", ("Toggle computer", "💻") }
    };

    private string Title => Known.TryGetValue(Action, out (string Title, string Icon) known) ? known.Title : "Unknown shortcut";
    private string Icon => Known.TryGetValue(Action, out (string Title, string Icon) known) ? known.Icon : "❔";

    protected override async Task OnInitializedAsync()
    {
        _result = Action.ToLowerInvariant() switch
        {
            "generic" => await State.SwitchDevice(EDevice.Generic, ESwitchAction.Toggle),
            "lamp" => await State.SwitchDevice(EDevice.Lamp, ESwitchAction.Toggle),
            "computer" => await State.SwitchDevice(EDevice.Computer, ESwitchAction.Toggle),
            "sleep" => await State.Sleep(),
            _ => "That shortcut does not exist."
        };
    }
}
