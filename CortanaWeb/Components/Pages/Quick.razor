@page "/quick/{Action}"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State

<PageTitle>@Title</PageTitle>

<div class="quick-run">
    <span class="quick-run-icon" aria-hidden="true">@Icon</span>
    <h1>@Title</h1>
    <p class="quick-run-result">@(_result ?? "Working...")</p>
    <a class="btn" href="/">Back to dashboard</a>
</div>

@code {
    [Parameter] public string Action { get; set; } = "";

    private string? _result;

    private const string Sleep = "sleep";

    private DeviceView? Target =>
        (State.Snapshot?.Devices ?? []).FirstOrDefault(device => device.Device.Equals(Action, StringComparison.OrdinalIgnoreCase));

    private string Title => Action.Equals(Sleep, StringComparison.OrdinalIgnoreCase)
        ? "Sleep mode"
        : Target is { } device ? $"Toggle {device.Name.ToLowerInvariant()}" : "Unknown shortcut";

    private string Icon => Action.Equals(Sleep, StringComparison.OrdinalIgnoreCase)
        ? "🛌"
        : Target?.Icon ?? "❔";

    protected override async Task OnInitializedAsync() =>
        _result = Action.Equals(Sleep, StringComparison.OrdinalIgnoreCase)
            ? await State.SetSleepMode(SwitchAction.Toggle)
            : Target is { } device
                ? await State.SwitchDevice(device.Device, SwitchAction.Toggle)
                : "That shortcut does not exist.";
}
