@page "/logs"
@attribute [Authorize(Policy = WebAuth.Policy)]
@rendermode InteractiveServer
@inject CortanaState State
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Logs</PageTitle>

<h1>Logs</h1>
<Toast @bind-Message="_message"/>

<section class="section">
    <header class="section-head">
        <h2>Mood</h2>
        <span class="badge mood-@State.Mood.ToString().ToLower()">@State.Mood</span>
    </header>
    <p class="mood-reason">@(State.MoodReason.Length > 0 ? State.MoodReason : "Nothing to report")</p>
</section>

<section class="section">
    <header class="section-head">
        <h2>Activity</h2>
        <div class="log-controls">
            <select @bind="_filter">
                <option value="">All sources</option>
                @foreach (NotificationSource source in Enum.GetValues<NotificationSource>())
                {
                    <option value="@source">@source</option>
                }
            </select>
            <button class="btn btn-small" disabled="@_busy" @onclick="Reload">Refresh</button>
            <button class="btn btn-off btn-small" disabled="@_busy" @onclick="Clear">Clear</button>
        </div>
    </header>

    @if (Visible.Count == 0)
    {
        <p class="section-hint">Nothing logged yet.</p>
    }
    else
    {
        <ol class="log-list">
            @foreach (NotificationEntry entry in Visible)
            {
                <li class="log-row log-@entry.Level.ToString().ToLower()">
                    <time>@entry.Timestamp.ToString("dd MMM HH:mm:ss")</time>
                    <span class="log-source">@entry.Source</span>
                    <span class="log-message">
                        @entry.Message
                        @if (!string.IsNullOrEmpty(entry.Reason))
                        {
                            <button class="log-why" @onclick="() => Toggle(entry)">@(_expanded.Contains(entry) ? "why ▾" : "why ▸")</button>
                            @if (_expanded.Contains(entry))
                            {
                                <span class="log-reason">@entry.Reason</span>
                            }
                        }
                    </span>
                </li>
            }
        </ol>
    }
</section>

<section class="section">
    <header class="section-head">
        <h2>Service journal</h2>
        <p class="section-hint">systemd output from the Pi</p>
    </header>

    <div class="field-row">
        <select @bind="_journalService" disabled="@_journalBusy">
            @foreach (ServiceId service in Enum.GetValues<ServiceId>())
            {
                <option value="@service">@service</option>
            }
        </select>
        <select @bind="_journalLines" disabled="@_journalBusy">
            <option value="50">50 lines</option>
            <option value="100">100 lines</option>
            <option value="200">200 lines</option>
            <option value="500">500 lines</option>
        </select>
        <button class="btn" disabled="@_journalBusy" @onclick="LoadJournal">Load</button>
    </div>

    @if (!string.IsNullOrEmpty(_journal))
    {
        <pre class="console journal">@_journal</pre>
    }
</section>

<section class="section">
    <header class="section-head">
        <h2>What the desktop reports</h2>
    </header>

    <div class="field-row">
        <select value="@Reporting" disabled="@(_busy || State.Activity is null)" @onchange="SetDetail">
            @foreach (ActivityDetail level in Enum.GetValues<ActivityDetail>())
            {
                <option value="@level">@level</option>
            }
        </select>
    </div>

    <p class="section-hint">
        @(State.Activity is null
            ? "The desktop agent is not connected"
            : $"Reporting {Describe(Reporting)}")
    </p>
</section>

<section class="section">
    <header class="section-head">
        <h2>Notifications</h2>
        <p class="section-hint">One persistent notification that always shows the newest state</p>
    </header>

    <div class="toggle-row">
        <div>
            <strong>Push to this device</strong>
            <small>@_permissionLabel</small>
        </div>
        <button class="switch @(_notify ? "switch-on" : "")" role="switch"
                aria-checked="@(_notify ? "true" : "false")" aria-label="Push notifications"
                disabled="@_busy" @onclick="ToggleNotifications"><span class="knob"></span></button>
    </div>

    <div class="options">
        <label><input type="checkbox" checked="@_alertsOnly" @onchange="OnAlertsOnly"/> Only warnings and alerts</label>
    </div>

    <div class="toggle-row">
        <div>
            <strong>Persistent status notification</strong>
        </div>
        <button class="switch @(_sticky ? "switch-on" : "")" role="switch"
                aria-checked="@(_sticky ? "true" : "false")" aria-label="Persistent notification"
                disabled="@(_busy || !_notify)" @onclick="ToggleSticky"><span class="knob"></span></button>
    </div>

    <div class="toggle-row">
        <div>
            <strong>Vibrate on events</strong>
        </div>
        <button class="switch @(_vibrate ? "switch-on" : "")" role="switch"
                aria-checked="@(_vibrate ? "true" : "false")" aria-label="Vibrate on events"
                disabled="@(_busy || !_notify)" @onclick="ToggleVibrate"><span class="knob"></span></button>
    </div>

    <p class="brain-label">Events that interrupt the status line</p>
    <div class="source-grid">
        @foreach (NotificationSource source in Enum.GetValues<NotificationSource>())
        {
            <label>
                <input type="checkbox" checked="@_sources.Contains(source)" @onchange="args => OnSource(source, args)"/> @source
            </label>
        }
    </div>

    @if (_notify)
    {
        <div class="btn-row" style="margin-top: 0.7rem;">
            <button class="btn btn-small" disabled="@_busy" @onclick="TestPush">Send</button>
        </div>
    }
</section>

@code {
    private ActivityDetail Reporting => State.Activity?.Detail ?? ActivityDetail.NowPlaying;

    private static string Describe(ActivityDetail level) => level switch
    {
        ActivityDetail.CategoryOnly => "the category only, no window titles or music",
        ActivityDetail.GameTitles => "the category and game titles, but not music",
        _ => "the category, game titles and what is playing"
    };

    private async Task SetDetail(ChangeEventArgs args)
    {
        if (!Enum.TryParse(args.Value?.ToString(), out ActivityDetail level)) return;

        _busy = true;
        try
        {
            _message = await State.ComputerCommand(CortanaLib.Primitives.ComputerCommand.SetActivityDetail, level.ToString());
        }
        finally
        {
            _busy = false;
        }
    }

    private readonly HashSet<NotificationSource> _sources = [.. Enum.GetValues<NotificationSource>()];
    private readonly HashSet<NotificationEntry> _expanded = [];

    private void Toggle(NotificationEntry entry)
    {
        if (!_expanded.Add(entry)) _expanded.Remove(entry);
    }

    private IDisposable? _subscription;
    private IReadOnlyList<NotificationEntry> _entries = [];
    private string _filter = "";
    private string? _message;
    private bool _busy;

    private ServiceId _journalService = ServiceId.Kernel;
    private int _journalLines = 100;
    private string? _journal;
    private bool _journalBusy;

    private bool _notify;
    private bool _alertsOnly = true;
    private bool _sticky;
    private bool _vibrate = true;
    private string _permissionLabel = "Off";

    private IReadOnlyList<NotificationEntry> Visible =>
        string.IsNullOrEmpty(_filter) ? _entries : [.. _entries.Where(entry => entry.Source.ToString() == _filter)];

    protected override async Task OnInitializedAsync()
    {
        _subscription = State.Subscribe(() => InvokeAsync(OnStateChanged));
        await Reload();
    }

    public void Dispose() => _subscription?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _notify = await Js.InvokeAsync<bool>("cortanaNotify.isEnabled");

            if (!_notify && await Js.InvokeAsync<string?>("cortanaPush.current") is { Length: > 0 })
                _notify = await Js.InvokeAsync<bool>("cortanaNotify.setEnabled", true);

            _permissionLabel = await Js.InvokeAsync<string>("cortanaNotify.permission");

            string[] saved = await Js.InvokeAsync<string[]>("cortanaNotify.sources");
            if (saved.Length > 0)
            {
                _sources.Clear();
                foreach (string name in saved)
                    if (Enum.TryParse(name, out NotificationSource parsed)) _sources.Add(parsed);
            }

            _alertsOnly = await Js.InvokeAsync<bool>("cortanaNotify.alertsOnly");
            _sticky = await Js.InvokeAsync<bool>("cortanaNotify.sticky");
            _vibrate = await Js.InvokeAsync<bool>("cortanaNotify.vibrate");
        }
        catch (JSException)
        {
            _permissionLabel = "Not supported by this browser";
        }

        StateHasChanged();
    }

    private async Task OnStateChanged()
    {
        await Reload();
        StateHasChanged();
    }

    private async Task Reload() => _entries = await State.Notifications();

    private async Task ToggleVibrate() => await Preference(async () =>
    {
        _vibrate = !_vibrate;
        await Js.InvokeVoidAsync("cortanaNotify.setVibrate", _vibrate);
    });

    private async Task ToggleSticky() => await Preference(async () =>
    {
        _sticky = !_sticky;
        await Js.InvokeVoidAsync("cortanaNotify.setSticky", _sticky);
    });

    private async Task OnAlertsOnly(ChangeEventArgs args) => await Preference(async () =>
    {
        _alertsOnly = args.Value is true;
        await Js.InvokeVoidAsync("cortanaNotify.setAlertsOnly", _alertsOnly);
    });

    private async Task OnSource(NotificationSource source, ChangeEventArgs args) => await Preference(async () =>
    {
        if (args.Value is true) _sources.Add(source);
        else _sources.Remove(source);

        await Js.InvokeVoidAsync("cortanaNotify.setSources", _sources.Select(entry => entry.ToString()).ToArray());
    });

    private async Task Preference(Func<Task> change)
    {
        _busy = true;
        try
        {
            await change();
            await Resubscribe();
        }
        catch (JSException)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Resubscribe()
    {
        if (!_notify) return;

        var device = await Js.InvokeAsync<PushDeviceRequest?>("cortanaPush.subscribe", (await State.PushKey()).Trim());
        if (device != null) _message = await State.PushSubscribe(Describe(device));
    }

    private PushDeviceRequest Describe(PushDeviceRequest device) => device with
    {
        StatusNotification = _sticky,
        Vibrate = _vibrate,
        AlertsOnly = _alertsOnly,
        Sources = _sources.Count == Enum.GetValues<NotificationSource>().Length ? [] : [.. _sources.Select(source => source.ToString())]
    };

    private async Task ToggleNotifications()
    {
        _busy = true;
        try
        {
            if (_notify)
            {
                string? endpoint = await Js.InvokeAsync<string?>("cortanaPush.unsubscribe");
                if (!string.IsNullOrEmpty(endpoint)) _message = await State.PushUnsubscribe(endpoint);

                await Js.InvokeAsync<bool>("cortanaNotify.toggle");
                _notify = false;
            }
            else
            {
                if (!await Js.InvokeAsync<bool>("cortanaPush.supported"))
                {
                    _permissionLabel = "Needs HTTPS, open the dashboard over your Tailscale address";
                    return;
                }

                var device = await Js.InvokeAsync<PushDeviceRequest?>("cortanaPush.subscribe", (await State.PushKey()).Trim());
                if (device == null)
                {
                    _permissionLabel = "Permission denied";
                    return;
                }

                _message = await State.PushSubscribe(Describe(device));
                await Js.InvokeAsync<bool>("cortanaNotify.toggle");
                _notify = true;
            }

            _permissionLabel = await Js.InvokeAsync<string>("cortanaNotify.permission");
        }
        catch (Exception ex)
        {
            _permissionLabel = ex is JSException ? "Not supported by this browser" : "Could not register this device";
            _notify = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadJournal()
    {
        _journalBusy = true;
        try
        {
            _journal = await State.Journal(_journalService, _journalLines);
        }
        finally
        {
            _journalBusy = false;
        }
    }

    private async Task TestPush()
    {
        _busy = true;
        try
        {
            _message = await State.PushTest();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Clear()
    {
        _busy = true;
        try
        {
            _message = await State.ClearNotifications();
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }
}
