@inject CortanaState State
@inject IJSRuntime Js

<Toast @bind-Message="_message"/>

<div class="chat-section">
    @if (ShowHeader)
    {
        <header class="section-head">
            <h2>Cortana</h2>
            <button class="btn btn-ghost" disabled="@(_busy || _turns.Count == 0)" @onclick="ClearAsync">New chat</button>
        </header>
    }

    <div class="chat-log" id="chat-log">
        @if (_turns.Count == 0)
        {
            <p class="chat-empty">What do you want to talk about?</p>
        }
        @foreach (Turn turn in _turns)
        {
            <div class="chat-turn @(turn.Mine ? "chat-mine" : "chat-hers")">
                <span class="chat-bubble">@turn.Text</span>
            </div>
        }
        @if (_busy)
        {
            <div class="chat-turn chat-hers">
                <span class="chat-bubble chat-typing"><i></i><i></i><i></i></span>
            </div>
        }
    </div>

    <div class="chat-input">
        <input class="input" placeholder="Message" maxlength="500" disabled="@_busy"
               @bind="_draft" @bind:event="oninput" @onkeydown="OnKey"/>
        <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft))" @onclick="Send">Send</button>
    </div>
</div>

@code {
    [Parameter] public bool ShowHeader { get; set; } = true;

    private readonly List<Turn> _turns = [];
    private readonly string _conversation = Conversations.Web;
    private string _draft = "";
    private string? _message;
    private bool _busy;

    private record Turn(string Text, bool Mine);

    /// One conversation for every browser, so a reload shows what was said and Cortana can speak into it
    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _turns.Clear();
        foreach (ChatTurn turn in await State.ChatHistory(_conversation)) _turns.Add(new Turn(turn.Text, turn.Mine));
    }

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey) await Send();
    }

    private async Task Send()
    {
        string question = _draft.Trim();
        if (_busy || question.Length == 0) return;

        _draft = "";
        _busy = true;
        _turns.Add(new Turn(question, true));
        await Scroll();

        try
        {
            _turns.Add(new Turn(await State.Ask(question, _conversation), false));
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
            await Scroll();
        }
    }

    /// Called from the dashboard as well as from the header, so it renders itself rather than trusting
    /// whoever asked to. The log is read back instead of just emptied: if the Kernel kept the
    /// conversation the turns come straight back, rather than a clear that only looked like one
    public async Task ClearAsync()
    {
        if (_busy) return;

        _busy = true;

        try
        {
            _message = await State.ResetChat(_conversation);
            await Reload();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task Scroll()
    {
        StateHasChanged();
        try
        {
            await Js.InvokeVoidAsync("cortanaScrollChat");
        }
        catch (JSException)
        {
        }
    }
}
