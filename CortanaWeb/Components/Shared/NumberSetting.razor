@inject CortanaState State

<div class="setting">
    <label for="@_id">
        <span class="setting-icon" aria-hidden="true">@Icon</span>
        <span>
            <strong>@Label</strong>
            @if (!string.IsNullOrEmpty(Hint))
            {
                <small>@Hint</small>
            }
        </span>
    </label>

    <div class="setting-input">
        <input id="@_id" type="number" min="@Min" max="@Max" step="@Step.ToString(CultureInfo.InvariantCulture)"
               value="@Draft.ToString(Format, CultureInfo.InvariantCulture)" @onchange="OnDraftChanged" disabled="@_busy"/>
        <button class="btn btn-small" disabled="@(_busy || Math.Abs(Draft - Current) < 0.001)" @onclick="Save">Save</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SettingKey Setting { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Hint { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100000;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public EventCallback<string> OnResult { get; set; }

    private readonly string _id = $"setting-{Guid.NewGuid():N}";
    private double? _draft;
    private bool _busy;

    private string Format => Step < 1 ? "0.##" : "0";

    private double Current => State.SettingDecimal(Setting);
    private double Draft => _draft ?? Current;

    private void OnDraftChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, out double parsed))
            _draft = Math.Clamp(parsed, Min, Max);
    }

    private async Task Save()
    {
        _busy = true;
        try
        {
            string result = await State.SetSetting(Setting, Draft.ToString(Format, CultureInfo.InvariantCulture));
            _draft = null;
            await OnResult.InvokeAsync(result);
        }
        finally
        {
            _busy = false;
        }
    }
}
