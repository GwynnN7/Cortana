@using System.Globalization

@if (Series is { Samples.Count: 0 })
{
    <div class="chart-wrap chart-empty-window">
        <svg class="chart" viewBox="0 0 @Width @Height" preserveAspectRatio="none" role="img" aria-label="No data in this window">
            @foreach (double tick in Ticks)
            {
                <line x1="0" x2="@Width" y1="@Y(tick).ToString("F1", Invariant)" y2="@Y(tick).ToString("F1", Invariant)"
                      stroke="var(--border)" stroke-width="1"/>
            }
        </svg>
        <span class="chart-empty-label">Nothing recorded in this window</span>
    </div>

    <div class="chart-axis">
        @foreach (DateTimeOffset moment in TimeTicks)
        {
            <span>@moment.ToString(Format)</span>
        }
    </div>
}
else if (Series is { Samples.Count: > 1 })
{
    <div class="chart-wrap">
        <div class="chart-y">
            @foreach (double tick in Ticks)
            {
                <span>@Label(tick)</span>
            }
        </div>

        <svg class="chart" viewBox="0 0 @Width @Height" preserveAspectRatio="none" role="img"
             aria-label="@Series.Metric over time">
            <defs>
                <linearGradient id="chart-fill-@Id" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                </linearGradient>
            </defs>

            @foreach (double tick in Ticks)
            {
                <line x1="0" x2="@Width" y1="@Y(tick).ToString("F1", Invariant)" y2="@Y(tick).ToString("F1", Invariant)"
                      stroke="var(--border)" stroke-width="1"/>
            }

            <path d="@Area" fill="url(#chart-fill-@Id)"/>
            <path d="@Line" fill="none" stroke="var(--accent)" stroke-width="2"
                  stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
        </svg>
    </div>

    <div class="chart-axis">
        @foreach (DateTimeOffset moment in TimeTicks)
        {
            <span>@moment.ToString(Format)</span>
        }
    </div>

    <div class="chart-legend">
        <span>min <strong>@Value(Series.Min)</strong></span>
        <span>avg <strong>@Value(Series.Average)</strong></span>
        <span>max <strong>@Value(Series.Max)</strong></span>
        <span class="note">@Series.Points samples</span>
    </div>
}
else if (Series is { Points: 1 })
{
    <p class="chart-empty">Only one sample so far — a line needs two. The next one is recorded within a few minutes.</p>
}
else
{
    <p class="chart-empty">Nothing recorded in this window yet.</p>
}

@code {
    [Parameter, EditorRequired] public HistorySeries? Series { get; set; }

    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }
    [Parameter] public bool Binary { get; set; }

    private const int Width = 600;
    private const int Height = 160;

    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private readonly string Id = Guid.NewGuid().ToString("N")[..6];

    private double Low => Min ?? Padded().Low;
    private double High => Max ?? Padded().High;

    private double Span => High - Low < 0.001 ? 1 : High - Low;

    private (double Low, double High) Padded()
    {
        if (Series!.Samples.Count == 0) return (0, 1);

        double low = Series.Samples.Min(point => point.Value);
        double high = Series!.Samples.Max(point => point.Value);
        double margin = high - low < 0.5 ? 0.5 : (high - low) * 0.1;

        return (Math.Floor(low - margin), Math.Ceiling(high + margin));
    }

    private IEnumerable<double> Ticks =>
        Binary ? [1, 0] : Enumerable.Range(0, 4).Select(step => High - Span * step / 3);

    private string Label(double value) =>
        Binary ? value >= 0.5 ? "On" : "Off" : value.ToString(Span >= 10 ? "0" : "0.#", Invariant);

    private string Value(double value) =>
        Binary ? $"{value * 100:0}% on" : $"{value.ToString("0.#", Invariant)}{Series!.Unit}";

    private IEnumerable<DateTimeOffset> TimeTicks =>
        Enumerable.Range(0, 5).Select(step => Series!.From + (Series.To - Series.From) * step / 4);

    private string Format => (Series!.To - Series.From).TotalHours > 30 ? "dd MMM" : "HH:mm";

    private double X(int index)
    {
        double span = (Series!.To - Series.From).TotalSeconds;

        return span <= 0
            ? (double)index / Math.Max(1, Series.Samples.Count - 1) * Width
            : Math.Clamp((Series.Samples[index].At - Series.From).TotalSeconds / span, 0, 1) * Width;
    }

    private double Y(double value) => Height - (Math.Clamp(value, Low, High) - Low) / Span * Height;

    private TimeSpan GapThreshold
    {
        get
        {
            List<double> deltas = Series!.Samples.Zip(Series.Samples.Skip(1), (a, b) => (b.At - a.At).TotalSeconds).Where(d => d > 0).ToList();
            if (deltas.Count == 0) return TimeSpan.FromMinutes(15);

            deltas.Sort();
            double median = deltas[deltas.Count / 2];
            return TimeSpan.FromSeconds(Math.Max(median * 3, 120));
        }
    }

    private List<List<int>> Segments
    {
        get
        {
            var segments = new List<List<int>>();
            segments.Add(new List<int>());
            TimeSpan gap = GapThreshold;

            for (var index = 0; index < Series!.Samples.Count; index++)
            {
                if (index > 0 && Series.Samples[index].At - Series.Samples[index - 1].At > gap && segments[^1].Count > 0)
                    segments.Add(new List<int>());

                segments[^1].Add(index);
            }

            return segments.Where(segment => segment.Count > 0).ToList();
        }
    }

    private string Line => string.Join(" ", Segments.Select(segment =>
        string.Join(" ", segment.Select((index, position) =>
            $"{(position == 0 ? "M" : "L")}{X(index).ToString("F1", Invariant)},{Y(Series!.Samples[index].Value).ToString("F1", Invariant)}"))));

    private string Area => string.Join(" ", Segments.Where(segment => segment.Count > 1).Select(segment =>
        string.Join(" ", segment.Select((index, position) =>
            $"{(position == 0 ? "M" : "L")}{X(index).ToString("F1", Invariant)},{Y(Series!.Samples[index].Value).ToString("F1", Invariant)}"))
        + $" L{X(segment[^1]).ToString("F1", Invariant)},{Height.ToString(Invariant)}"
        + $" L{X(segment[0]).ToString("F1", Invariant)},{Height.ToString(Invariant)} Z"));
}
