@if (Metrics is { } pc)
{
    <section class="section @(pc.Stale ? "section-stale" : "")">
        <header class="section-head">
            <h2>@pc.Host</h2>
            @if (!pc.Stale && Activity is { Category: not ActivityCategory.Idle } doing)
            {
                <span class="badge activity activity-@doing.Category.ToString().ToLower()">@Describe(doing)</span>
            }
            else
            {
                <span class="badge @(pc.Stale ? "badge-bad" : "badge-ok")">
                    @(pc.Stale ? $"last seen {pc.Timestamp:HH:mm}" : "Online")
                </span>
            }
        </header>

        <div class="metric-body">
        @if (Activity?.Playing is { } track)
        {
            <p class="now-playing">@(track.Paused ? "⏸" : "♪") @Track(track)</p>
        }
        <p class="metric-device">CPU</p>
        <Metric Name="Load" Percent="pc.CpuLoad" Detail="@($"{pc.CpuLoad:F0}%")" Nested="true"/>
        <Metric Name="Temp" Percent="pc.CpuTemp" Detail="@($"{pc.CpuTemp:F0} °C")" Nested="true" Thermal="true"/>

        @if (pc.GpuLoad > 0 || pc.GpuTemp > 0)
        {
            <p class="metric-device">GPU</p>
            <Metric Name="Load" Percent="pc.GpuLoad" Detail="@($"{pc.GpuLoad:F0}%")" Nested="true"/>
            <Metric Name="Temp" Percent="pc.GpuTemp" Detail="@($"{pc.GpuTemp:F0} °C")" Nested="true" Thermal="true"/>
        }

        <p class="metric-device">Memory</p>
        <Metric Name="RAM" Percent="Ratio(pc.MemoryUsed, pc.MemoryTotal)" Detail="@($"{pc.MemoryUsed:F1}/{pc.MemoryTotal:F1} GB")" Nested="true"/>
        <Metric Name="Disk" Percent="Ratio(pc.DiskUsed, pc.DiskTotal)" Detail="@($"{pc.DiskUsed:F0}/{pc.DiskTotal:F0} GB")" Nested="true"/>

        @if (Activity is not null)
        {
            <ActivityRibbon/>
        }
        </div>
    </section>
}

@code {
    [Parameter] public MetricsView? Metrics { get; set; }

    [Parameter] public DesktopActivity? Activity { get; set; }

    private static string Describe(DesktopActivity activity) => activity switch
    {
        { Locked: true } => "locked",
        { Category: ActivityCategory.Gaming, Fullscreen: true } => "gaming · do not disturb",
        { Category: ActivityCategory.Media, Fullscreen: true } => "watching · do not disturb",
        { Subject.Length: > 0 } named => $"{named.Category.ToString().ToLower()} · {named.Subject}",
        _ => activity.Category.ToString().ToLower()
    };

    private static string Track(NowPlaying track) => track switch
    {
        { Title.Length: > 0, Album.Length: > 0 } => $"{track.Title} — {track.Album}",
        { Title.Length: > 0 } => track.Title,
        { Paused: true } => "paused",
        _ => "playing"
    };

    private static double Ratio(double used, double total) => total > 0 ? used / total * 100 : 0;
}
