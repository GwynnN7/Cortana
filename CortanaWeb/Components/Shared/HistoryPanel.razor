@inject CortanaState State

<section class="section">
    <header class="section-head">
        <h2>@Title</h2>
    </header>

    <div class="field-row">
        <select @bind="_metric" @bind:after="Reset" disabled="@_loading">
            @foreach (string metric in Metrics)
            {
                <option value="@metric">@Pretty(metric)</option>
            }
        </select>
        <select @bind="_hours" @bind:after="Reset" disabled="@_loading">
            <option value="6">6 hours</option>
            <option value="12">12 hours</option>
            <option value="24">24 hours</option>
            <option value="72">3 days</option>
            <option value="168">7 days</option>
            <option value="720">30 days</option>
        </select>
    </div>

    <div class="chart-window">@Window</div>

    <div class="chart-nav">
        <button class="btn btn-small" disabled="@_loading" @onclick="Earlier">◀</button>
        <button class="btn btn-small" disabled="@(_loading || _offset == 0)" @onclick="Later">▶</button>
        <button class="btn btn-ghost btn-small" disabled="@(_loading || _offset == 0)" @onclick="Reset">Now</button>
    </div>

    @if (_loading || _series is null)
    {
        <p class="chart-empty">Reading</p>
    }
    else if (_series is { Points: 0 } && _offset == 0)
    {
        <p class="chart-empty">Nothing recorded for this yet</p>
    }
    else
    {
        <HistoryChart Series="_series" Min="Bounds().Low" Max="Bounds().High" Binary="IsBinary"/>
    }
</section>

@code {
    [Parameter, EditorRequired] public string[] Metrics { get; set; } = [];
    [Parameter] public string Title { get; set; } = "History";

    private string _metric = "";
    private int _hours = 12;
    private HistorySeries? _series;
    private bool _loading;
    private int _offset;

    private DateTimeOffset? Until => _offset == 0 ? null : DateTimeOffset.Now.AddHours(-(double)_hours * _offset);

    private string Window
    {
        get
        {
            if (_series is not { } series) return "";
            if (_offset == 0) return $"{series.From:dd MMM HH:mm} → now";

            string to = series.From.Date == series.To.Date ? $"{series.To:HH:mm}" : $"{series.To:dd MMM HH:mm}";
            return $"{series.From:dd MMM HH:mm} → {to}";
        }
    }

    private SensorView? Registered(string metric) =>
        (State.Snapshot?.Sensors ?? []).FirstOrDefault(view => view.Sensor.Equals(metric, StringComparison.OrdinalIgnoreCase));

    private bool IsBinary =>
        Registered(_metric)?.Kind == ReadingKind.Boolean
        || (State.Snapshot?.Devices ?? []).Any(view => view.Device.Equals(_metric, StringComparison.OrdinalIgnoreCase));

    private (double? Low, double? High) Bounds() =>
        IsBinary ? (0, 1) : Registered(_metric) is { Min: { } low, Max: { } high } ? (low, high) : (null, null);

    /// The series the Kernel records itself, which are not registered sensors and so have no name to
    /// look up. Title-casing the id gave the desktop one "Activity", the same label as a renamed
    /// at_desk, and the chart picker showed two rows that read identically
    private static readonly Dictionary<string, string> Recorded = new(StringComparer.OrdinalIgnoreCase)
    {
        ["activity"] = "Desktop activity",
        ["music"] = "Music"
    };

    /// Two metrics can still land on the same name, because any sensor can be renamed to anything.
    /// A picker with two identical rows is unusable, so the id breaks the tie rather than the label
    private string Pretty(string metric)
    {
        string name = Name(metric);
        return Metrics.Count(other => Name(other).Equals(name, StringComparison.OrdinalIgnoreCase)) > 1
            ? $"{name} ({metric})"
            : name;
    }

    private string Name(string metric) =>
        Registered(metric)?.Name
        ?? (State.Snapshot?.Devices ?? []).FirstOrDefault(view => view.Device.Equals(metric, StringComparison.OrdinalIgnoreCase))?.Name
        ?? Recorded.GetValueOrDefault(metric)
        ?? char.ToUpper(metric[0]) + metric[1..];

    protected override async Task OnParametersSetAsync()
    {
        if (Metrics.Contains(_metric)) return;

        _metric = Metrics.FirstOrDefault() ?? "";
        _offset = 0;
        await Load();
    }

    private Task Earlier()
    {
        _offset++;
        return Load();
    }

    private Task Later()
    {
        _offset = Math.Max(0, _offset - 1);
        return Load();
    }

    private Task Reset()
    {
        _offset = 0;
        return Load();
    }

    private async Task Load()
    {
        if (string.IsNullOrEmpty(_metric)) return;

        _series = null;
        _loading = true;
        StateHasChanged();

        try
        {
            _series = await State.History(_metric, _hours, Until);
        }
        finally
        {
            _loading = false;
        }
    }
}
