@inject CortanaState State

<article class="card device-card @(IsOn ? "is-on" : "is-off")">
    <header>
        <span class="device-icon" aria-hidden="true">@Icon</span>
        <div>
            <h3>@Device</h3>
            <p class="device-state">@State.DeviceStatus(Device)</p>
        </div>
    </header>

    <div class="btn-row">
        <button class="btn btn-on" disabled="@_busy" @onclick="() => Switch(SwitchAction.On)">On</button>
        <button class="btn btn-off" disabled="@_busy" @onclick="() => Switch(SwitchAction.Off)">Off</button>
    </div>
    <button class="btn btn-block" disabled="@_busy" @onclick="() => Switch(SwitchAction.Toggle)">Toggle</button>
</article>

@code {
    [Parameter, EditorRequired] public DeviceId Device { get; set; }
    [Parameter] public string Icon { get; set; } = "⏻";
    [Parameter] public EventCallback<string> OnResult { get; set; }

    private bool _busy;

    private bool IsOn => State.IsDeviceOn(Device);

    private async Task Switch(SwitchAction action)
    {
        _busy = true;
        try
        {
            await OnResult.InvokeAsync(await State.SwitchDevice(Device, action));
        }
        finally
        {
            _busy = false;
        }
    }
}
