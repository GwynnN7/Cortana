@inject CortanaState State
@implements IDisposable

<Toast @bind-Message="_message"/>

<section class="section">
    <header class="section-head">
        <h2>Active</h2>
        <span class="badge">@_schedules.Count</span>
        <button class="btn btn-small" disabled="@_busy" @onclick="OpenDraft">New schedule</button>
    </header>

    @if (_schedules.Count == 0)
    {
        <p class="section-hint">Nothing scheduled yet</p>
    }
    else
    {
        <div class="schedule-list">
            @foreach (ScheduleView entry in _schedules)
            {
                <article class="schedule @(entry.Schedule.Enabled || Spent(entry) ? "" : "is-disabled")">
                    <div class="schedule-main">
                        <strong>@entry.Schedule.Name @(Spent(entry) ? "· done" : "")</strong>
                        <span class="schedule-when">@Describe(entry)</span>
                        <span class="schedule-action">@ActionText(entry.Schedule.Action)</span>
                        @if (entry.Schedule.LastRun != null)
                        {
                            <span class="schedule-last">Last: @entry.Schedule.LastRun?.ToString("dd MMM HH:mm") — @entry.Schedule.LastResult</span>
                        }
                    </div>
                    <div class="btn-row wrap">
                        <button class="btn btn-small" disabled="@_busy" @onclick='() => Command(entry.Schedule.Id, "run")'>
                            @(Spent(entry) ? "Run again" : "Run")
                        </button>
                        @if (!Spent(entry))
                        {
                            <button class="btn btn-small" disabled="@_busy" @onclick='() => Command(entry.Schedule.Id, entry.Schedule.Enabled ? "disable" : "enable")'>
                                @(entry.Schedule.Enabled ? "Disable" : "Enable")
                            </button>
                        }
                        <button class="btn btn-off btn-small" disabled="@_busy" @onclick="() => Delete(entry.Schedule.Id)">Delete</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

<Modal Open="_open" Title="New schedule" OnClose="Close">
    <ChildContent>
    <div class="field-row">
        <input type="text" placeholder="Name" @bind="_draft.Name" @bind:event="oninput" disabled="@_busy"/>
    </div>

    <div class="field-row">
        <select @bind="_draft.Trigger" disabled="@_busy">
            @foreach (ScheduleTrigger trigger in Enum.GetValues<ScheduleTrigger>())
            {
                <option value="@trigger">@trigger</option>
            }
        </select>

        @switch (_draft.Trigger)
        {
            case ScheduleTrigger.Once:
                <input type="datetime-local" @bind="_draft.At" disabled="@_busy"/>
                break;
            case ScheduleTrigger.Interval:
                <input type="number" min="10" placeholder="Seconds" @bind="_draft.IntervalSeconds" disabled="@_busy"/>
                break;
            case ScheduleTrigger.Daily:
                <input type="time" @bind="_draft.Time" disabled="@_busy"/>
                break;
            case ScheduleTrigger.Weekly:
                <select @bind="_draft.Day" disabled="@_busy">
                    @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
                    {
                        <option value="@day">@day</option>
                    }
                </select>
                <input type="time" @bind="_draft.Time" disabled="@_busy"/>
                break;
            case ScheduleTrigger.Event:
                <select @bind="_draft.Event" disabled="@_busy">
                    @foreach (ScheduleEvent scheduleEvent in Enum.GetValues<ScheduleEvent>())
                    {
                        <option value="@scheduleEvent">@scheduleEvent</option>
                    }
                </select>
                break;
        }
    </div>

    @if (_draft.Trigger == ScheduleTrigger.Event)
    {
        <div class="options">
            <label><input type="checkbox" @bind="_draft.RunOnce"/> Run only once, then disable</label>
        </div>
    }

    <div class="field-row">
        <select value="@_draft.ActionType" disabled="@_busy" @onchange="OnActionType">
            @foreach (ScheduleActionType action in Enum.GetValues<ScheduleActionType>())
            {
                <option value="@action">@action</option>
            }
        </select>

        @if (TargetOptions(_draft.ActionType) is { Count: > 0 } targets)
        {
            <select @bind="_draft.Target" disabled="@_busy">
                @foreach ((string id, string label) in targets)
                {
                    <option value="@id">@label</option>
                }
            </select>
        }
        else
        {
            <input type="text" placeholder="Target" @bind="_draft.Target" @bind:event="oninput" disabled="@_busy"/>
        }

        @if (ValueOptions(_draft.ActionType) is { Count: > 0 } values)
        {
            <select @bind="_draft.Value" disabled="@_busy">
                @foreach (string value in values)
                {
                    <option value="@value">@value</option>
                }
            </select>
        }
        else
        {
            <input type="text" placeholder="Value" @bind="_draft.Value" @bind:event="oninput" disabled="@_busy"/>
        }
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_draft.Name))" @onclick="Create">Create</button>
        <button class="btn btn-ghost" disabled="@_busy" @onclick="Close">Cancel</button>
    </Footer>
</Modal>

@code {
    private IDisposable? _subscription;
    private IReadOnlyList<ScheduleView> _schedules = [];
    private string? _message;
    private bool _busy;
    private bool _open;

    private readonly Draft _draft = new();

    private sealed class Draft
    {
        public string Name { get; set; } = "";
        public ScheduleTrigger Trigger { get; set; } = ScheduleTrigger.Daily;
        public ScheduleActionType ActionType { get; set; } = ScheduleActionType.SwitchDevice;
        public string Target { get; set; } = "";
        public string Value { get; set; } = nameof(SwitchAction.Toggle);
        public DateTime At { get; set; } = DateTime.Now.AddHours(1);
        public int IntervalSeconds { get; set; } = 3600;
        public DateTime Time { get; set; } = DateTime.Today.AddHours(8);
        public DayOfWeek Day { get; set; } = DayOfWeek.Monday;
        public ScheduleEvent Event { get; set; } = ScheduleEvent.ComputerTurnedOn;
        public bool RunOnce { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));
        await Reload();
        _draft.Target = TargetOptions(_draft.ActionType).FirstOrDefault().Id ?? "";
    }

    public void Dispose() => _subscription?.Dispose();

    private async Task Reload() => _schedules = await State.Schedules();

    private void OpenDraft()
    {
        _draft.Target = TargetOptions(_draft.ActionType).FirstOrDefault().Id ?? "";
        _open = true;
    }

    private void Close()
    {
        _open = false;
        _draft.Name = "";
    }

    private void OnActionType(ChangeEventArgs args)
    {
        if (!Enum.TryParse(args.Value?.ToString(), out ScheduleActionType action)) return;

        _draft.ActionType = action;
        _draft.Target = TargetOptions(action).FirstOrDefault().Id ?? "";
        _draft.Value = ValueOptions(action).FirstOrDefault() ?? "";
    }

    /// A target is stored by id and shown by whatever the fabric calls it
    private List<(string Id, string Label)> TargetOptions(ScheduleActionType action) => action switch
    {
        ScheduleActionType.SwitchDevice => [.. (State.Snapshot?.Devices ?? []).Select(view => (view.Device, view.Name))],
        ScheduleActionType.CommandComputer => Named<ComputerCommand>(),
        ScheduleActionType.CommandRaspberry => Named<RaspberryCommand>(),
        ScheduleActionType.ChangeSetting => Named<SettingKey>(),
        ScheduleActionType.SendNotification => Named<NotificationChannel>(),
        ScheduleActionType.ControlService => Named<ServiceId>(),
        _ => []
    };

    private static List<(string Id, string Label)> Named<T>() where T : struct, Enum =>
        [.. Enum.GetNames<T>().Select(name => (name, name))];

    private static List<string> ValueOptions(ScheduleActionType action) => action switch
    {
        ScheduleActionType.SwitchDevice or ScheduleActionType.SetSleepMode
            or ScheduleActionType.SetAutomation => [.. Enum.GetNames<SwitchAction>()],
        ScheduleActionType.ControlService => [.. Enum.GetNames<ServiceAction>()],
        _ => []
    };

    private async Task Create()
    {
        _busy = true;
        try
        {
            var request = new CreateScheduleRequest(
                _draft.Name,
                _draft.Trigger,
                _draft.ActionType,
                _draft.Target,
                _draft.Value,
                _draft.Trigger == ScheduleTrigger.Once ? new DateTimeOffset(_draft.At) : null,
                _draft.IntervalSeconds,
                _draft.Time.Hour,
                _draft.Time.Minute,
                _draft.Trigger == ScheduleTrigger.Weekly ? _draft.Day : null,
                _draft.Trigger == ScheduleTrigger.Event ? _draft.Event : null,
                _draft.Trigger == ScheduleTrigger.Event && _draft.RunOnce,
                0,
                "web");

            _message = await State.CreateSchedule(request);
            Close();
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Command(string id, string command)
    {
        _busy = true;
        try
        {
            _message = await State.CommandSchedule(id, command);
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Delete(string id)
    {
        _busy = true;
        try
        {
            _message = await State.DeleteSchedule(id);
            await Reload();
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool Spent(ScheduleView entry) => entry.NextRun == null && entry.Schedule.LastRun != null;

    private static string Describe(ScheduleView entry)
    {
        Schedule schedule = entry.Schedule;
        string when = schedule.Trigger switch
        {
            ScheduleTrigger.Once => $"Once at {schedule.At:dd MMM HH:mm}",
            ScheduleTrigger.Interval => $"Every {schedule.IntervalSeconds}s",
            ScheduleTrigger.Daily => $"Daily at {schedule.Hour:00}:{schedule.Minute:00}",
            ScheduleTrigger.Weekly => $"{schedule.Day} at {schedule.Hour:00}:{schedule.Minute:00}",
            ScheduleTrigger.Event => $"On {schedule.Event}",
            _ => "Unknown"
        };

        if (entry.NextRun != null) return $"{when} · next {entry.NextRun:dd MMM HH:mm}";

        return entry.Schedule.LastRun != null ? $"{when} · ran {entry.Schedule.LastRun:dd MMM HH:mm}" : when;
    }

    private string ActionText(ScheduleAction action)
    {
        string target = action.Type == ScheduleActionType.SwitchDevice
            ? (State.Snapshot?.Devices ?? []).FirstOrDefault(view => view.Device == action.Target)?.Name ?? action.Target
            : action.Target;

        if (action.Type == ScheduleActionType.SendNotification) return $"Notify {target}: {action.Value}";

        return string.IsNullOrEmpty(action.Value) ? $"{action.Type} {target}" : $"{action.Type} {target} → {action.Value}";
    }
}
