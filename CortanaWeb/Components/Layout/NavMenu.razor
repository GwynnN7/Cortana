@inject WebAuth Auth

<nav class="nav">
    <div class="brand">
        <img src="favicon.png" alt="Cortana" width="34" height="34"/>
        <div>
            <strong>Cortana</strong>
            <small>Home Assistant</small>
        </div>
    </div>

    <div class="nav-links">
        @foreach ((string href, string label, string icon, bool primary) in Links)
        {
            <NavLink class="@($"nav-link {(primary ? "nav-primary" : "nav-secondary")}")" href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <span class="nav-icon" aria-hidden="true">@icon</span>
                <span class="nav-label">@label</span>
            </NavLink>
        }
    </div>

    @if (Auth.Enabled)
    {
        <form class="nav-logout" method="post" action="/auth/logout">
            <button type="submit" class="btn btn-ghost btn-block">Sign out</button>
        </form>
    }
</nav>

@code {
    private static readonly (string Href, string Label, string Icon, bool Primary)[] Links =
    [
        ("", "Dashboard", "\u25C8", true),
        ("devices", "Devices", "\u25A3", true),
        ("sensors", "Sensors", "\u25C9", true),
        ("raspberry", "Raspberry", "\u25A4", false),
        ("schedules", "Schedules", "\u25F7", false),
        ("subfunctions", "Subfunctions", "\u25A6", false),
        ("utility", "Utility", "\u2699", false)
    ];
}
