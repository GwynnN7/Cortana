@inject WebAuth Auth
@inject CortanaState State
@implements IDisposable

<nav class="nav">
    <div class="brand">
        <img src="favicon.png" alt="Cortana" width="34" height="34"/>
        <div>
            <strong>Cortana</strong>
            <small>Home Assistant</small>
        </div>
    </div>

    <div class="nav-links">
        @foreach ((string href, string label, string icon, bool primary) in Links)
        {
            <NavLink class="@($"nav-link {(primary ? "nav-primary" : "nav-secondary")} {(href == "" ? "nav-home" : "")}")" href="@href" Match="@(href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <span class="nav-icon"><Icon Name="@icon" Size="20"/></span>
                <span class="nav-label">@label</span>
            </NavLink>
        }
    </div>

    @if (Auth.Enabled)
    {
        <form class="nav-logout" method="post" action="/auth/logout">
            <button type="submit" class="btn btn-ghost btn-block">Sign out</button>
        </form>
    }
</nav>

@code {
    private IDisposable? _subscription;

    protected override void OnInitialized() => _subscription = State.Subscribe(() => InvokeAsync(StateHasChanged));

    public void Dispose() => _subscription?.Dispose();

    private static readonly (string Href, string Label, string Icon, bool Primary)[] Links =
    [
        ("", "Dashboard", "dashboard", true),
        ("devices", "Devices", "devices", true),
        ("sensors", "Sensors", "sensors", true),
        ("core", "Core", "raspberry", false),
        ("memory", "Memory", "memory", false),
        ("utility", "Utility", "utility", false),
        ("notes", "Notes", "note", false),
        ("hardware", "Hardware", "subfunctions", false),
        ("docs", "Docs", "logs", false),
        ("logs", "Logs", "logs", false),
        ("settings", "Settings", "settings", false)
    ];
}
