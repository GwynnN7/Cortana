[Unit]
Description=Cortana Desktop Agent
After=network.target

[Service]
ExecStartPre=/usr/bin/dotnet build %h/Projects/Cortana/CortanaDesktop -o %h/.local/share/cortana/desktop --artifacts-path %h/.local/share/cortana/desktop/lib
ExecStart=%h/.local/share/cortana/desktop/CortanaDesktop
WorkingDirectory=%h
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=CortanaDesktop

[Install]
WantedBy=default.target
